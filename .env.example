# Copie para .env (que está no .gitignore) e preencha. NUNCA publique o .env.
DESK_OPERATOR_KEY=sua_chave_de_operador
DESK_PUBLIC_KEY=sua_public_key
# Host do seu portal Desk Manager (ex.: suaempresa.desk.ms)
DESK_PORTAL_HOST=suaempresa.desk.ms
# Código do Maestro que recebe o código deste repositório
MAESTRO_COD=00000
